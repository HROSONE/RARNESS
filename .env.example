# Provedor principal: gemini, groq, cerebras, openrouter, anthropic ou openai
AI_PROVIDER=gemini

# 1. Google AI Studio (Gemini) — exclusivo gemini-3.8-flash ou gemini-4-argon (nunca usar 2.0/2.5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Groq Cloud (Grátis em https://console.groq.com/keys — até 500 t/s)
# Modelos recomendados: openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.3-70b-versatile
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3. Cerebras Inference (Grátis 1M tokens/dia sem cartão em https://cloud.cerebras.ai — até 3.000 t/s)
# Modelos recomendados: gpt-oss-120b, qwen-3.8-27b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# 4. OpenRouter (Grátis em https://openrouter.ai/keys — modelos :free de 256K a 1M de contexto)
# Modelos recomendados: cohere/north-mini-code:free, poolside/laguna-s-2.1:free, qwen/qwen3.8-27b:free, thinkingmachines/inkling:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free

# Token para a API web na Vercel (opcional)
RARNESS_ACCESS_TOKEN=
