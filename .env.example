# Provedor: gemini, anthropic, openai ou openrouter
AI_PROVIDER=gemini

# Google AI Studio (Gemini) — use apenas gemini-3.8-flash ou gemini-4-argon (nunca usar 2.0/2.5)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter (opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Token para a API web na Vercel (opcional)
RARNESS_ACCESS_TOKEN=
