# Provedor: gemini, anthropic, openai ou openrouter
AI_PROVIDER=gemini

# Google AI Studio (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (Claude Code / Claude Sonnet)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# OpenRouter (opcional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Token para a API web na Vercel (opcional)
RARNESS_ACCESS_TOKEN=
